{
  "name": "decision-graph-interview",
  "version": "0.1.0-alpha.0",
  "description": "Local, evidence-bound decision interviews for agent workflows.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "decision-graph": "./bin/decision-graph.mjs"
  },
  "exports": {
    ".": "./src/core/index.mjs"
  },
  "files": [
    "bin",
    "src",
    "integrations",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/lint.mjs",
    "check": "node scripts/check-public-contract.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "start": "node bin/decision-graph.mjs start"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/decision-graph-interview.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/decision-graph-interview/issues"
  },
  "homepage": "https://github.com/OWNER/decision-graph-interview#readme"
}
